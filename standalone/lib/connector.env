# OpenConnector's settings, as the role's controlclaw-connector unit sets them: loopback only, the
# firewall agent's gate is what agents dial. Its keys are in connector-keys.env (firstrun.sh).
HOST=127.0.0.1
PORT=3910
OOMOL_CONNECT_CATALOG_LAZY_SCHEMAS=true
OOMOL_CONNECT_DATA_DIR=/opt/controlclaw/connector
