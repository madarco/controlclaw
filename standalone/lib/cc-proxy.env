# The proxy's settings, as the role's controlclaw-mitmproxy unit sets them, for the Docker image and
# the VM install. systemd's EnvironmentFile format: KEY=value, no quotes, no expansion.
# Secrets the firewall agent writes for the proxy live on a tmpfs (/run/mitm/config).
MITM_RULES_PATH=/run/mitm/config/rules.json
MITM_CREDENTIALS_PATH=/run/mitm/config/credentials.json
MITM_GRANTS_PATH=/run/mitm/config/grants.json
MITM_PENDING_PATH=/run/mitm/config/pending.jsonl
MITM_IDENTITIES_PATH=/run/mitm/config/identities.json
MITM_EXIT_PATH=/run/mitm/config/exit.json
MITM_CONTENT_RULES_PATH=/run/mitm/config/content-rules.json
MITM_LOGIN_TARGETS_PATH=/run/mitm/config/login-targets.json
MITM_LOG_FILE=/opt/controlclaw/mitm/logs/traffic.jsonl
MITM_LOG_MAX_BYTES=8388608
MITM_CA_DIR=/opt/controlclaw/mitm/ca
# The firewall agent's ORG_ID (local in standalone mode): the tenant in the traffic log.
MITM_TENANT=local
# No dev escape hatches on a firewall people use.
MITM_DEV_LOG_SECRETS=0
MITM_DEV_ALLOW_PLAINTEXT_STORE=0
MITM_DEV_INSECURE_UPSTREAM=0
MITM_DEV_ALLOW_DIRECT_EGRESS=0
