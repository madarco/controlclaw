# The firewall agent's settings, as the role's controlclaw-mitm-agent unit sets them, without the
# control plane's URLs (STORE_URL, RULES_URL, ...), for the Docker image and the VM install.
# systemd's EnvironmentFile format: KEY=value, no quotes, no expansion.
#
# Standalone mode (docs/standalone/standalone-mode.md): no console; the rules and agents are in the
# agent's own control plane (cc-local, /opt/controlclaw/state/local.db), and pages open with links
# `mitm-agent open <page>` signs.
MITM_MODE=standalone
KEYS_DIR=/opt/controlclaw/keys
BOX_KEY_PATH=/opt/controlclaw/keys/box_key
AGENT_PORT=3100
PROXY_CONFIG_DIR=/run/mitm/config
PENDING_PATH=/run/mitm/config/pending.jsonl
GRANTS_PATH=/run/mitm/config/grants.json
CA_CERT_PATH=/opt/controlclaw/mitm/ca/ca-cert.pem
TRAFFIC_LOG_PATH=/opt/controlclaw/mitm/logs/traffic.jsonl
ACTIVITY_CURSOR_PATH=/opt/controlclaw/mitm/logs/activity.cursor
# App integrations: OpenConnector on loopback, and the gates agents dial (3900 apps, 3940 tools and
# MCP servers). The gates listen on CONNECTOR_GATE_BIND, which is also the address the agents are
# given, so it is the firewall's address as the agents reach it; set it in firewall.env (or
# docker run -e). Unset, the gates and integrations stay off.
CONNECTOR_URL=http://127.0.0.1:3910
CONNECTOR_GATE_PORT=3900
EXIT_STORE_PATH=/opt/controlclaw/state/exit.enc
# Inbound webhooks: loopback, for a reverse proxy (Caddy) on the same host to hand /hook/* to.
INGRESS_PORT=8790
INGRESS_BIND=127.0.0.1
WEBHOOK_STORE_PATH=/opt/controlclaw/state/webhooks.enc
WEBHOOKS_PATH=/opt/controlclaw/state/webhooks.json
