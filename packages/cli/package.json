{
  "name": "@controlclaw/cli",
  "version": "0.1.0",
  "description": "Connect a machine running OpenClaw to a ControlClaw firewall: doctor, connect, disconnect, status.",
  "type": "module",
  "bin": { "controlclaw": "dist/index.js" },
  "main": "./dist/index.js",
  "files": ["dist/index.js", "README.md"],
  "engines": { "node": ">=22" },
  "repository": { "type": "git", "url": "git+https://github.com/madarco/controlclaw-oss.git", "directory": "packages/cli" },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "tsx --test src/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0"
  },
  "license": "AGPL-3.0-only"
}
