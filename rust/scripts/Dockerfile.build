# The image build-box.sh --docker and release.sh build in: Ubuntu 24.04, as on the boxes.
# Everything a build uses is in the image, so a release does not depend on what the network
# serves on the day it is built:
#   - the base by the digest of its linux/amd64 image (not the multi-arch index, which would give
#     another machine's architecture), and built and run with --platform linux/amd64;
#   - every package, ca-certificates included, from Ubuntu's archive as it was on APT_SNAPSHOT
#     (snapshot.ubuntu.com). The bare image has no CA certificates, so TLS to that one host is not
#     verified; apt still checks the archive's GPG signatures, which is what vouches for the packages;
#   - rustup-init by version, and the toolchain with the components rust-toolchain.toml names.
FROM --platform=linux/amd64 ubuntu@sha256:78d4744ead1f5b19b04d0df558ab182a5300903900755e515b2ca4d10eb2044d
ARG APT_SNAPSHOT=20261020T000000Z
RUN echo 'Acquire::https::snapshot.ubuntu.com::Verify-Peer "false";' > /etc/apt/apt.conf.d/50snapshot \
 && apt-get update --snapshot "$APT_SNAPSHOT" \
 && apt-get install -y --no-install-recommends --snapshot "$APT_SNAPSHOT" ca-certificates curl gcc libc6-dev musl-tools binutils git \
      cmake clang libclang-dev make \
 && rm -rf /var/lib/apt/lists/* /etc/apt/apt.conf.d/50snapshot
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
ARG RUSTUP_VERSION=1.28.2
RUN curl -sSfo /tmp/rustup-init "https://static.rust-lang.org/rustup/archive/$RUSTUP_VERSION/x86_64-unknown-linux-gnu/rustup-init" \
 && chmod +x /tmp/rustup-init \
 && /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain 1.99.1 \
      --target x86_64-unknown-linux-musl,aarch64-unknown-linux-musl --component clippy,rustfmt \
 && rm /tmp/rustup-init \
 && chmod -R a+rwX /opt/cargo /opt/rustup
# BoringSSL (cc-proxy's upstream TLS, the btls crate) is C++: musl.cc's cross toolchains have the
# C++ compiler and a static libstdc++ for musl (GCC 11.2.1), pinned by their hashes in musl-cross.sh.
# The aarch64 one is for the arm builds (build-box.sh --arch aarch64), made on this amd64 image.
COPY musl-cross.sh /tmp/musl-cross.sh
RUN /tmp/musl-cross.sh install /opt/musl-cross x86_64 \
 && /tmp/musl-cross.sh install /opt/musl-cross-aarch64 aarch64 \
 && rm /tmp/musl-cross.sh
ENV PATH=/opt/musl-cross/bin:/opt/musl-cross-aarch64/bin:$PATH
