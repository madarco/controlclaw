{
  "name": "k2 telegram in: blocked messages are taken out, the offset kept, the person told",
  "files": {
    "content-rules.json": {
      "version": 1,
      "rules": [
        {
          "id": "nope",
          "name": "nope",
          "direction": "in",
          "channels": [
            "telegram"
          ],
          "patterns": [
            "forbidden topic"
          ],
          "detectors": [],
          "action": "block",
          "reason": "nope reason"
        },
        {
          "id": "both",
          "name": "both",
          "direction": "both",
          "channels": [
            "telegram"
          ],
          "patterns": [
            "budget"
          ],
          "detectors": [],
          "action": "log",
          "reason": "b reason"
        }
      ]
    }
  },
  "steps": [
    {
      "name": "one blocked in the middle",
      "upstream": {
        "status": 200,
        "json": {
          "ok": true,
          "result": [
            {
              "update_id": 10,
              "message": {
                "message_id": 10,
                "text": "hi",
                "chat": {
                  "id": 7,
                  "type": "private"
                },
                "from": {
                  "id": 7
                }
              }
            },
            {
              "update_id": 11,
              "message": {
                "message_id": 11,
                "text": "about the forbidden topic",
                "chat": {
                  "id": 7,
                  "type": "private"
                },
                "from": {
                  "id": 7
                }
              }
            },
            {
              "update_id": 12,
              "message": {
                "message_id": 12,
                "text": "hello",
                "chat": {
                  "id": 7,
                  "type": "private"
                },
                "from": {
                  "id": 7
                }
              }
            }
          ]
        }
      },
      "request": {
        "method": "POST",
        "host": "api.telegram.org",
        "path": "/bot123456:CC-TG-placeholder/getUpdates",
        "json": {
          "offset": 1,
          "timeout": 30
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "ok": true,
          "result": [
            {
              "update_id": 10,
              "message": {
                "message_id": 10,
                "text": "hi",
                "chat": {
                  "id": 7,
                  "type": "private"
                },
                "from": {
                  "id": 7
                }
              }
            },
            {
              "update_id": 12,
              "message": {
                "message_id": 12,
                "text": "hello",
                "chat": {
                  "id": 7,
                  "type": "private"
                },
                "from": {
                  "id": 7
                }
              }
            }
          ]
        },
        "loopback": {
          "content": {
            "/notice": [
              {
                "kind": "in",
                "botId": "123456",
                "chatId": "7",
                "vmId": "vm_test",
                "reason": "nope reason"
              }
            ],
            "/stopped": [
              {
                "rule": {
                  "id": "nope"
                },
                "channel": "telegram",
                "direction": "in",
                "text": "about the forbidden topic"
              }
            ]
          }
        },
        "audit": [
          {
            "rule": "nope",
            "channel": "telegram",
            "direction": "in",
            "action": "block"
          }
        ]
      }
    },
    {
      "name": "the last one blocked: its id stays, empty",
      "upstream": {
        "status": 200,
        "json": {
          "ok": true,
          "result": [
            {
              "update_id": 12,
              "message": {
                "message_id": 12,
                "text": "hello",
                "chat": {
                  "id": 7,
                  "type": "private"
                },
                "from": {
                  "id": 7
                }
              }
            },
            {
              "update_id": 13,
              "message": {
                "message_id": 13,
                "text": "forbidden topic again",
                "chat": {
                  "id": 7,
                  "type": "private"
                },
                "from": {
                  "id": 7
                }
              }
            }
          ]
        }
      },
      "request": {
        "method": "POST",
        "host": "api.telegram.org",
        "path": "/bot123456:CC-TG-placeholder/getUpdates",
        "json": {
          "offset": 1,
          "timeout": 30
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "ok": true,
          "result": [
            {
              "update_id": 12,
              "message": {
                "message_id": 12,
                "text": "hello",
                "chat": {
                  "id": 7,
                  "type": "private"
                },
                "from": {
                  "id": 7
                }
              }
            },
            {
              "update_id": 13
            }
          ]
        }
      }
    },
    {
      "name": "a person may send the agent a key",
      "upstream": {
        "status": 200,
        "json": {
          "ok": true,
          "result": [
            {
              "update_id": 14,
              "message": {
                "message_id": 14,
                "text": "sk-proj-KKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKK",
                "chat": {
                  "id": 7,
                  "type": "private"
                },
                "from": {
                  "id": 7
                }
              }
            }
          ]
        }
      },
      "request": {
        "method": "POST",
        "host": "api.telegram.org",
        "path": "/bot123456:CC-TG-placeholder/getUpdates",
        "json": {
          "offset": 1,
          "timeout": 30
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "ok": true,
          "result": [
            {
              "update_id": 14,
              "message": {
                "message_id": 14,
                "text": "sk-proj-KKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKK",
                "chat": {
                  "id": 7,
                  "type": "private"
                },
                "from": {
                  "id": 7
                }
              }
            }
          ]
        },
        "audit": []
      }
    },
    {
      "name": "a log rule coming in is recorded",
      "upstream": {
        "status": 200,
        "json": {
          "ok": true,
          "result": [
            {
              "update_id": 15,
              "message": {
                "message_id": 15,
                "text": "the budget",
                "chat": {
                  "id": 7,
                  "type": "private"
                },
                "from": {
                  "id": 7
                }
              }
            }
          ]
        }
      },
      "request": {
        "method": "POST",
        "host": "api.telegram.org",
        "path": "/bot123456:CC-TG-placeholder/getUpdates",
        "json": {
          "offset": 1,
          "timeout": 30
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "ok": true,
          "result": [
            {
              "update_id": 15,
              "message": {
                "message_id": 15,
                "text": "the budget",
                "chat": {
                  "id": 7,
                  "type": "private"
                },
                "from": {
                  "id": 7
                }
              }
            }
          ]
        },
        "audit": [
          {
            "rule": "both",
            "direction": "in",
            "action": "log"
          }
        ]
      }
    },
    {
      "name": "too long to check: held back like a block",
      "upstream": {
        "status": 200,
        "json": {
          "ok": true,
          "result": [
            {
              "update_id": 30,
              "message": {
                "message_id": 30,
                "text": {
                  "$repeat": "y",
                  "n": 70000
                },
                "chat": {
                  "id": 7,
                  "type": "private"
                },
                "from": {
                  "id": 7
                }
              }
            },
            {
              "update_id": 31,
              "message": {
                "message_id": 31,
                "text": "hello",
                "chat": {
                  "id": 7,
                  "type": "private"
                },
                "from": {
                  "id": 7
                }
              }
            }
          ]
        }
      },
      "request": {
        "method": "POST",
        "host": "api.telegram.org",
        "path": "/bot123456:CC-TG-placeholder/getUpdates",
        "json": {
          "offset": 1,
          "timeout": 30
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "ok": true,
          "result": [
            {
              "update_id": 31,
              "message": {
                "message_id": 31,
                "text": "hello",
                "chat": {
                  "id": 7,
                  "type": "private"
                },
                "from": {
                  "id": 7
                }
              }
            }
          ]
        },
        "audit": [
          {
            "rule": "error",
            "direction": "in",
            "action": "block"
          }
        ]
      }
    },
    {
      "name": "an answer that cannot be read is not passed on",
      "upstream": {
        "status": 200,
        "body": "{\"ok\": true, \"result\": [ {\"update_id\": 40, \"message\": {\"text\": \"forbidden topic\"",
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "request": {
        "method": "POST",
        "host": "api.telegram.org",
        "path": "/bot123456:CC-TG-placeholder/getUpdates",
        "json": {}
      },
      "expect": {
        "status": 200,
        "json": {
          "ok": true,
          "result": []
        },
        "audit": [
          {
            "rule": "error",
            "direction": "in",
            "action": "block",
            "detail": "unreadable answer"
          }
        ]
      }
    },
    {
      "name": "an error answer is left alone",
      "upstream": {
        "status": 409,
        "json": {
          "ok": false,
          "error_code": 409,
          "description": "Conflict"
        }
      },
      "request": {
        "method": "POST",
        "host": "api.telegram.org",
        "path": "/bot123456:CC-TG-placeholder/getUpdates",
        "json": {}
      },
      "expect": {
        "status": 409,
        "json": {
          "ok": false,
          "error_code": 409,
          "description": "Conflict"
        }
      }
    }
  ]
}
