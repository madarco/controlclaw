{
  "name": "k4 host review of #539: formatting, numbers, charsets, strict multipart, unreadable JSON (production #561)",
  "addon_has": "_content_evaluate_shown",
  "files": {
    "content-rules.json": {
      "version": 1,
      "rules": [
        {
          "id": "cust",
          "name": "cust",
          "direction": "out",
          "channels": [
            "slack",
            "web"
          ],
          "patterns": [
            "customer list"
          ],
          "detectors": [],
          "action": "block",
          "reason": "cust reason"
        },
        {
          "id": "card",
          "name": "card",
          "direction": "out",
          "channels": [
            "slack",
            "web"
          ],
          "patterns": [],
          "detectors": [
            "card"
          ],
          "action": "block",
          "reason": "card reason"
        }
      ]
    }
  },
  "steps": [
    {
      "name": "slack: formatting the chat undoes (the <https://x.y|cust>omer list)",
      "request": {
        "method": "POST",
        "host": "slack.com",
        "path": "/api/chat.postMessage",
        "headers": {
          "Authorization": "Bearer __cc_slack_bot_conn1",
          "Content-Type": "application/json"
        },
        "body": "{\"channel\": \"C1\", \"text\": \"the <https://x.y|cust>omer list\"}"
      },
      "expect": {
        "status": 200,
        "json_subset": {
          "ok": false,
          "error": "blocked_by_organization_rules"
        },
        "upstream": "none"
      }
    },
    {
      "name": "slack: formatting the chat undoes (the cust*om*er list)",
      "request": {
        "method": "POST",
        "host": "slack.com",
        "path": "/api/chat.postMessage",
        "headers": {
          "Authorization": "Bearer __cc_slack_bot_conn1",
          "Content-Type": "application/json"
        },
        "body": "{\"channel\": \"C1\", \"text\": \"the cust*om*er list\"}"
      },
      "expect": {
        "status": 200,
        "json_subset": {
          "ok": false,
          "error": "blocked_by_organization_rules"
        },
        "upstream": "none"
      }
    },
    {
      "name": "slack: formatting the chat undoes (the customer&#32;list)",
      "request": {
        "method": "POST",
        "host": "slack.com",
        "path": "/api/chat.postMessage",
        "headers": {
          "Authorization": "Bearer __cc_slack_bot_conn1",
          "Content-Type": "application/json"
        },
        "body": "{\"channel\": \"C1\", \"text\": \"the customer&#32;list\"}"
      },
      "expect": {
        "status": 200,
        "json_subset": {
          "ok": false,
          "error": "blocked_by_organization_rules"
        },
        "upstream": "none"
      }
    },
    {
      "name": "slack: a card number as a JSON number",
      "request": {
        "method": "POST",
        "host": "slack.com",
        "path": "/api/chat.postMessage",
        "headers": {
          "Authorization": "Bearer __cc_slack_bot_conn1",
          "Content-Type": "application/json"
        },
        "body": "{\"channel\": \"C1\", \"text\": 4111111111111111}"
      },
      "expect": {
        "status": 200,
        "json_subset": {
          "ok": false,
          "error": "blocked_by_organization_rules"
        },
        "upstream": "none"
      }
    },
    {
      "name": "slack: another charset is not read, so refused",
      "request": {
        "method": "POST",
        "host": "slack.com",
        "path": "/api/chat.postMessage",
        "headers": {
          "Authorization": "Bearer __cc_slack_bot_conn1",
          "Content-Type": "application/json; charset=latin-1"
        },
        "body": "{\"channel\": \"C1\", \"text\": \"hi\"}"
      },
      "expect": {
        "status": 200,
        "json_subset": {
          "ok": false,
          "error": "blocked_by_organization_rules"
        },
        "upstream": "none"
      }
    },
    {
      "name": "slack: UTF-8 named in capitals is read and goes",
      "request": {
        "method": "POST",
        "host": "slack.com",
        "path": "/api/chat.postMessage",
        "headers": {
          "Authorization": "Bearer __cc_slack_bot_conn1",
          "Content-Type": "application/json; charset=UTF-8"
        },
        "body": "{\"channel\": \"C1\", \"text\": \"hi\"}"
      },
      "upstream": {
        "status": 200,
        "json": {
          "ok": true
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "web: a quoted boundary is read",
      "request": {
        "method": "POST",
        "host": "forms.example.com",
        "path": "/submit",
        "headers": {
          "Content-Type": "multipart/form-data; boundary=\"XyZ\""
        },
        "body": "--XyZ\r\nContent-Disposition: form-data; name=\"note\"\r\n\r\nthe customer list\r\n--XyZ--\r\n"
      },
      "expect": {
        "status": 403,
        "json_subset": {
          "error": "blocked_by_content_rule"
        },
        "upstream": "none"
      }
    },
    {
      "name": "web: the boundary parameter in capitals is read",
      "request": {
        "method": "POST",
        "host": "forms.example.com",
        "path": "/submit",
        "headers": {
          "Content-Type": "multipart/form-data; Boundary=XyZ"
        },
        "body": "--XyZ\r\nContent-Disposition: form-data; name=\"note\"\r\n\r\nthe customer list\r\n--XyZ--\r\n"
      },
      "expect": {
        "status": 403,
        "json_subset": {
          "error": "blocked_by_content_rule"
        },
        "upstream": "none"
      }
    },
    {
      "name": "web: a body that does not split on its boundary is refused",
      "request": {
        "method": "POST",
        "host": "forms.example.com",
        "path": "/submit",
        "headers": {
          "Content-Type": "multipart/form-data; boundary=Other"
        },
        "body": "--XyZ\r\nContent-Disposition: form-data; name=\"note\"\r\n\r\nthe customer list\r\n--XyZ--\r\n"
      },
      "expect": {
        "status": 403,
        "json_subset": {
          "error": "blocked_by_content_rule"
        },
        "upstream": "none"
      }
    },
    {
      "name": "web: a base64 part is refused",
      "request": {
        "method": "POST",
        "host": "forms.example.com",
        "path": "/submit",
        "headers": {
          "Content-Type": "multipart/form-data; boundary=XyZ"
        },
        "body": "--XyZ\r\nContent-Disposition: form-data; name=\"note\"\r\nContent-Transfer-Encoding: base64\r\n\r\naGVsbG8=\r\n--XyZ--\r\n"
      },
      "expect": {
        "status": 403,
        "json_subset": {
          "error": "blocked_by_content_rule"
        },
        "upstream": "none"
      }
    },
    {
      "name": "web: a clean form goes",
      "request": {
        "method": "POST",
        "host": "forms.example.com",
        "path": "/submit",
        "headers": {
          "Content-Type": "multipart/form-data; boundary=XyZ"
        },
        "body": "--XyZ\r\nContent-Disposition: form-data; name=\"note\"\r\n\r\nhello\r\n--XyZ--\r\n"
      },
      "upstream": {
        "status": 200,
        "body": "ok"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "web: JSON deeper than the walk: every string, escapes undone",
      "request": {
        "method": "POST",
        "host": "forms.example.com",
        "path": "/submit",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "[[[[[[[[[[[[[[[[[[[[[[[[[\"the cust\\u006fmer list\"]]]]]]]]]]]]]]]]]]]]]]]]]"
      },
      "expect": {
        "status": 403,
        "json_subset": {
          "error": "blocked_by_content_rule"
        },
        "upstream": "none"
      }
    },
    {
      "name": "web: a number where a text goes is read",
      "request": {
        "method": "POST",
        "host": "forms.example.com",
        "path": "/submit",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"order\": 4111111111111111}"
      },
      "expect": {
        "status": 403,
        "json_subset": {
          "error": "blocked_by_content_rule"
        },
        "upstream": "none"
      }
    }
  ]
}
