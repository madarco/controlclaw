{
  "name": "k1 engine: the core secrets rule with no org rules, and rules that cannot be known refuse",
  "files": {
    "content-rules.json": {
      "version": 1,
      "rules": []
    }
  },
  "steps": [
    {
      "name": "no organization rules: an ordinary message goes",
      "upstream": {
        "status": 200,
        "json": {
          "ok": true
        }
      },
      "request": {
        "method": "POST",
        "host": "api.telegram.org",
        "path": "/bot123456:CC-TG-placeholder/sendMessage",
        "json": {
          "chat_id": 42,
          "text": "hello there"
        }
      },
      "expect": {
        "status": 200,
        "upstream": {
          "json": {
            "chat_id": 42,
            "text": "hello there"
          }
        },
        "audit": []
      }
    },
    {
      "name": "a key is blocked by the core rule, and its text is not handed over",
      "request": {
        "method": "POST",
        "host": "api.telegram.org",
        "path": "/bot123456:CC-TG-placeholder/sendMessage",
        "json": {
          "chat_id": 42,
          "text": "the key is sk-proj-NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN"
        }
      },
      "expect": {
        "status": 400,
        "json": {
          "ok": false,
          "error_code": 400,
          "description": "Bad Request: blocked by your organization's rules: it looks like it contains a password, key or token"
        },
        "upstream": "none",
        "loopback": {
          "content": {
            "/stopped": [
              {
                "rule": {
                  "id": "core-leaking-secrets",
                  "name": "Leaking secrets",
                  "reason": "it looks like it contains a password, key or token"
                },
                "text": ""
              }
            ]
          }
        },
        "audit": [
          {
            "rule": "core-leaking-secrets",
            "action": "block",
            "channel": "telegram",
            "direction": "out"
          }
        ],
        "audit_lacks": [
          "sk-proj"
        ]
      }
    },
    {
      "name": "a key coming in is not the secrets rule's business",
      "upstream": {
        "status": 200,
        "json": {
          "ok": true,
          "result": [
            {
              "update_id": 14,
              "message": {
                "message_id": 14,
                "text": "sk-proj-QQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQ",
                "chat": {
                  "id": 7
                }
              }
            }
          ]
        }
      },
      "request": {
        "method": "POST",
        "host": "api.telegram.org",
        "path": "/bot123456:CC-TG-placeholder/getUpdates",
        "json": {
          "offset": 14
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "ok": true,
          "result": [
            {
              "update_id": 14,
              "message": {
                "message_id": 14,
                "text": "sk-proj-QQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQ",
                "chat": {
                  "id": 7
                }
              }
            }
          ]
        },
        "audit": []
      }
    },
    {
      "name": "a broken rule file refuses with the check that could not run",
      "files": {
        "content-rules.json": "not json"
      },
      "request": {
        "method": "POST",
        "host": "api.telegram.org",
        "path": "/bot123456:CC-TG-placeholder/sendMessage",
        "json": {
          "chat_id": 42,
          "text": "hello"
        }
      },
      "expect": {
        "status": 400,
        "json": {
          "ok": false,
          "error_code": 400,
          "description": "Bad Request: blocked by your organization's rules: the check could not run"
        },
        "upstream": "none",
        "audit": [
          {
            "rule": "error",
            "action": "block",
            "channel": "telegram",
            "direction": "out"
          }
        ],
        "traffic": [
          {
            "effect": "block",
            "rule": "content: error",
            "status": 400
          }
        ]
      }
    },
    {
      "name": "a rule of the wrong shape is a broken file too",
      "files": {
        "content-rules.json": {
          "version": 1,
          "rules": [
            {
              "id": "x"
            }
          ]
        }
      },
      "request": {
        "method": "POST",
        "host": "api.telegram.org",
        "path": "/bot123456:CC-TG-placeholder/sendMessage",
        "json": {
          "chat_id": 42,
          "text": "hello"
        }
      },
      "expect": {
        "status": 400,
        "upstream": "none",
        "json_subset": {
          "description": "Bad Request: blocked by your organization's rules: the check could not run"
        }
      }
    },
    {
      "name": "the mitm-agent could not open its store: unknown, not none",
      "files": {
        "content-rules.json": {
          "version": 1,
          "unreadable": true
        }
      },
      "request": {
        "method": "POST",
        "host": "api.telegram.org",
        "path": "/bot123456:CC-TG-placeholder/sendMessage",
        "json": {
          "chat_id": 42,
          "text": "hello"
        }
      },
      "expect": {
        "status": 400,
        "upstream": "none"
      }
    },
    {
      "name": "no file at all (the mitm-agent has not written it yet)",
      "files": {
        "content-rules.json": null
      },
      "request": {
        "method": "POST",
        "host": "api.telegram.org",
        "path": "/bot123456:CC-TG-placeholder/sendMessage",
        "json": {
          "chat_id": 42,
          "text": "hello"
        }
      },
      "expect": {
        "status": 400,
        "upstream": "none",
        "audit": [
          {
            "rule": "error",
            "action": "block"
          }
        ]
      }
    },
    {
      "name": "the polls are refused before Telegram is asked, with its own retry-after",
      "request": {
        "method": "POST",
        "host": "api.telegram.org",
        "path": "/bot123456:CC-TG-placeholder/getUpdates",
        "json": {}
      },
      "expect": {
        "status": 429,
        "json": {
          "ok": false,
          "error_code": 429,
          "description": "Too Many Requests: retry after 5 (the firewall is loading its rules)",
          "parameters": {
            "retry_after": 5
          }
        },
        "upstream": "none",
        "audit": [
          {
            "rule": "error",
            "action": "wait",
            "channel": "telegram",
            "direction": "in",
            "detail": "rules unknown"
          }
        ],
        "traffic": [
          {
            "effect": "block",
            "rule": "content: rules unknown",
            "status": 429
          }
        ]
      }
    }
  ]
}
