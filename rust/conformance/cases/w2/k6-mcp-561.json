{
  "name": "k6 mcp: tool calls not in plain UTF-8 JSON are refused with their id (production #561)",
  "addon_has": "_mcp_odd_keys",
  "files": {
    "content-rules.json": {
      "version": 1,
      "rules": []
    }
  },
  "steps": [
    {
      "name": "a BOM: refused, the call's id kept",
      "request": {
        "method": "POST",
        "host": "mcp.example.com",
        "path": "/mcp",
        "headers": {
          "Content-Type": "application/json"
        },
        "body_b64": "77u/eyJqc29ucnBjIjogIjIuMCIsICJpZCI6IDQyLCAibWV0aG9kIjogInRvb2xzL2NhbGwiLCAicGFyYW1zIjogeyJuYW1lIjogImRlbGV0ZV9kb2MiLCAiYXJndW1lbnRzIjogeyJpZCI6ICJ4In19fQ=="
      },
      "expect": {
        "status": 400,
        "upstream": "none",
        "no_loopback": [
          "mcp"
        ],
        "json": {
          "jsonrpc": "2.0",
          "id": 42,
          "error": {
            "code": -32001,
            "message": "The firewall could not read this tool call, so it did not send it. Send it as plain UTF-8 JSON."
          }
        },
        "traffic": [
          {
            "effect": "block",
            "rule": "integrations: unreadable",
            "status": 400
          }
        ]
      }
    },
    {
      "name": "UTF-16: refused",
      "request": {
        "method": "POST",
        "host": "mcp.example.com",
        "path": "/mcp",
        "headers": {
          "Content-Type": "application/json; charset=utf-16le"
        },
        "body_b64": ""
      },
      "expect": {
        "status": 400,
        "upstream": "none",
        "no_loopback": [
          "mcp"
        ],
        "json": {
          "jsonrpc": "2.0",
          "id": 42,
